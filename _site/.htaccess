# ==============================================================================
# 1. SET HOME.HTML AS THE DEFAULT INDEX PAGE
# ==============================================================================
DirectoryIndex home.html index.html index.php

# Enable URL Rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect root request directly to home.html if needed
  # (DirectoryIndex handles this, but mod_rewrite ensures clean routing)

  # ============================================================================
  # 2. REMOVE .HTML EXTENSIONS FROM URLS (CLEAN URLS)
  # Allows visiting 'yoursite.com/projects' instead of 'yoursite.com/projects.html'
  # ============================================================================
  
  # Redirect /filename.html to /filename (301 Permanent Redirect)
  RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
  RewriteRule ^ %1 [R=301,L]

  # Internally map /filename to /filename.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^ %{REQUEST_URI}.html [L]

  # Redirect old index.html links to root or home
  RewriteCond %{THE_REQUEST} \s/+(index|home)\.html[\s?] [NC]
  RewriteRule ^(index|home)\.html$ / [R=301,L]
</IfModule>

# ==============================================================================
# 3. FAST LOADING & CACHING FOR PORTFOLIO IMAGES & ASSETS
# Instructs browsers to store images locally so pages load instantly on repeat visits
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Cache Images (PNG, JPG, WEBP, SVG, GIF) for 1 Year
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"

  # Cache Web Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # Cache CSS and JavaScript for 1 Month
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ==============================================================================
# 4. GZIP COMPRESSION (REDUCES HTML/CSS/JS FILE SIZE)
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript
</IfModule>

# ==============================================================================
# 5. SECURITY & CLEANUP
# Disable Directory Browsing (Prevents people from seeing raw file lists in folders)
# ==============================================================================
Options -Indexes
